.env
.env.*
!.env.example
# Claude Code 런타임 파일(스케줄 락 등) — 로컬 상태라 추적하지 않는다
.claude/
# md 동기화 로컬 오버라이드(OBSIDIAN_SYNC_DEST 등) — 사용자마다 경로가 달라서 커밋 안 함
scripts/md-sync.local
**/node_modules/
**/dist/
**/target/
**/__pycache__/
*.tsbuildinfo
.DS_Store
inbox/archive_ochestration/**
!inbox/archive_ochestration/.gitkeep
obsidian/**
!obsidian/.gitkeep
backups/**
!backups/.gitkeep
backup-obsidian-migration/
# 틱 아카이브 원본 — 계속 커지는 데이터라 git으로 안 다룬다(NAS로 백업, scripts/backup-tick-archive.sh 참고)
/trading-tick-archive/
/.kis-cache/
# 크립토 페이퍼 전략 런타임 상태(JSON) — trading-tick-archive와 같은 이유로 git 제외
/trading-crypto-paper-state/
# trading/ 봇이 받아둔 시세/온체인 캐시 데이터 — 소스 아님, 재생성 가능
/trading/.rs_cache/
# Large source-of-truth market data snapshots are kept local and never committed.
/trading/docs/research/kr_us_loop_v1/data_mirror/
# Heavy research artifacts (pkl/npz/outputs/data) — local only, GitHub 100MB limit
/logs/
/trading/docs/research/**/*.pkl
/trading/docs/research/**/*.npz
/trading/docs/research/lev_loop/B/out/
/trading/docs/research/lev_loop/R2A/out/
/trading/docs/research/lev_loop/R2B/data/
/trading/docs/research/lev_loop/R2C/data/
/trading/docs/research/lev_loop/C/results.json
/trading/docs/research/rebal_loop/B/.nbc/
