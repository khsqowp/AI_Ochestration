AUTH_ENABLED=false
AUTH_COOKIE_SECURE=false
DEV_ADMIN_EMAIL=owner@local.dev
DEV_ADMIN_NAME=Owner
MYSQL_DATABASE=orchestration
MYSQL_USER=orchestrator
MYSQL_PASSWORD=change-me-before-sharing
MYSQL_ROOT_PASSWORD=change-root-password
N8N_ENCRYPTION_KEY=replace-with-a-long-random-string-before-use
# Cloudflare Zero Trust > Networks > Tunnels에서 발급받은 터널 토큰. 외부 접속을 위한 cloudflared 컨테이너가 사용합니다.
CLOUDFLARE_TUNNEL_TOKEN=
N8N_DISPATCH_ENABLED=false
# n8n에서 이 webhook을 받는 워크플로를 만들어야 다이제스트가 실제로 이메일/Slack 등으로 전달됩니다.
N8N_DIGEST_WEBHOOK_URL=http://n8n:5678/webhook/digest
# 아카이브에 새 노트가 생성될 때마다 호출되는 webhook. 마찬가지로 이 webhook을 받는 n8n 워크플로가 있어야 전달됩니다.
N8N_ARCHIVE_WEBHOOK_URL=http://n8n:5678/webhook/archive-created
# 일간/주간 다이제스트 생성 및 발송 시각(cron). 기본값은 매일/매주 월요일 오전 9시(컨테이너 시간대 기준).
DIGEST_DAILY_CRON=0 0 9 * * *
DIGEST_WEEKLY_CRON=0 0 9 * * MON
# 등록된 수집 사이트 중 주기가 도래한 것을 매일 이 시각에 수집(cron). 기본값은 오전 7시(컨테이너 시간대 기준).
SOURCE_DAILY_CRON=0 0 7 * * *
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
CHATGPT_API_KEY=
# 바이낸스 스팟 테스트넷(testnet.binance.vision) API 키 — 모의투자 단계에서 사용. TRADE+USER_DATA 권한만 필요.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_SECRET_KEY=
# 바이낸스 선물 테스트넷(testnet.binancefuture.com) API 키 — 스팟 테스트넷과 별도 계정/키. 펀딩비 차익거래(현물 롱+선물 숏) 모의투자에 사용.
BINANCE_FUTURE_TESTNET_API_KEY=
BINANCE_FUTURE_TESTNET_SECRET_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_MODEL=deepseek-v4-pro
OPENAI_MODEL=gpt-4o-mini
# 아카이브 RAG 검색(질문에 답하기 위해 관련 노트를 찾는 용도)에 쓰는 임베딩 모델
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Gemini Flex 대기 허용 시간(15분), GPT·DeepSeek 검토/판단 제한(3분)
GEMINI_TIMEOUT_SECONDS=900
DECISION_TIMEOUT_SECONDS=180
# 팀장의 장문 아카이브 작성(thinking+긴 출력)은 검토용 3분 제한을 넘기기 쉬워 별도로 둡니다.
LONG_FORM_TIMEOUT_SECONDS=420
# 검토/팀장/PM 단계에서 담당 모델이 실패하면 다른 모델로 재시도하는 총 시도 횟수. 1이면 폴백 비활성화.
LLM_MAX_PROVIDER_ATTEMPTS=2
LLM_MAX_TASK_CHARACTERS=12000
TASK_WORKFLOW_CONCURRENCY=2
# 팀장 노트 생성 한도(토큰). 분량을 강제하지 않되, 상세히 쓸 여유를 남겨둡니다.
ARCHIVE_MAX_OUTPUT_TOKENS=9000
# 주간 아카이브 정리 주기(기본 7일). 서로 다른 주제 폴더에 저장된 중복 노트를 찾아 병합하고,
# 지워지는 쪽은 삭제하지 않고 obsidian/_archived/로 옮깁니다.
ARCHIVE_MAINTENANCE_DELAY_MS=604800000
# 새 보안/경제 출처 후보를 Gemini가 자동으로 제안하는 주기(기본 7일). 바로 등록하지 않고 승인 대기열에 쌓입니다.
SOURCE_DISCOVERY_DELAY_MS=604800000
# 이번 달 누적 추정 비용(USD)이 이 값을 넘으면 사용량 화면에 경고를 표시합니다. 실제 청구액이 아닌 추정치 기준입니다.
BUDGET_USD_PER_MONTH=20.00
# 모델별 토큰 비용 추정 단가(USD / 100만 토큰). 실제 계약·할인 단가가 있으면 이 값을 바꾸세요.
# Gemini는 2.5 Flash Flex 기준이며 Google Search grounding, 캐시, 세금은 토큰 비용에 포함하지 않습니다.
GEMINI_INPUT_USD_PER_MILLION=0.25
GEMINI_OUTPUT_USD_PER_MILLION=1.50
DEEPSEEK_INPUT_USD_PER_MILLION=0.435
DEEPSEEK_OUTPUT_USD_PER_MILLION=0.87
OPENAI_INPUT_USD_PER_MILLION=0.15
OPENAI_OUTPUT_USD_PER_MILLION=0.60
