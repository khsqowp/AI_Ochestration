    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst domainLabel = { SECURITY: '보안', ECONOMY: '경제', GENERAL: '일반' }[body.domain] || body.domain;\nconst stripMarkdown = (text) => text\n  .replace(/^#{1,6}\\s+/gm, '')\n  .replace(/\\*\\*(.+?)\\*\\*/g, '$1')\n  .replace(/__(.+?)__/g, '$1')\n  .replace(/^>\\s?/gm, '')\n  .replace(/^\\s*[-*_]{3,}\\s*$/gm, '');\nconst lines = [];\nlines.push(`*[${domainLabel}] 새 아카이브 노트* — ${body.title}`);\nlines.push('');\nlines.push(stripMarkdown(body.contentPreview));\nlines.push('');\nlines.push(`전체 내용: 파일 아카이브 → ${body.archivePath}`);\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
      "id": "c1d1e1f1-2a2a-2a2a-2a2a-2a2a2a2a2a13",
