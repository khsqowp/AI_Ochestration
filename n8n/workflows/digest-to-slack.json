    {
      "parameters": {
        "jsCode": "const body = $json.body;\nconst periodLabel = body.period === 'DAILY' ? '일간' : '주간';\nconst domainBreakdown = Object.entries(body.byDomain || {}).map(([k, v]) => `${k}: ${v}`).join(', ') || '없음';\nconst lines = [];\nlines.push(`*${periodLabel} 다이제스트* (${body.from} ~ ${body.to})`);\nlines.push(`총 ${body.total}건 · 완료 ${body.completed} · 실패 ${body.failed}`);\nlines.push(`도메인별: ${domainBreakdown}`);\nconst failed = body.failedTasks || [];\nconst noContent = body.noContentSources || [];\nif (noContent.length) {\n  lines.push('');\n  lines.push('*비활성화 고려 (연속 무의미 수집)*');\n  for (const s of noContent) lines.push(`• ${s.name} — ${s.consecutiveNoContentCycles}회 연속`);\n}\nif (failed.length) {\n  lines.push('');\n  lines.push('*실패한 작업*');\n  for (const t of failed.slice(0, 10)) lines.push(`• ${t.title} — ${t.detail || '사유 미상'}`);\n}\nreturn [{ json: { text: lines.join('\\n') } }];"
      },
